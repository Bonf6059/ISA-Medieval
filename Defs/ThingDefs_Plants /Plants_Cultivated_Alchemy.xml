	<!--========== Flowers ==========-->
	
	<ThingDef ParentName="HealrootBase" Name="ISA_MindwortBase">
		<defName>ISA_Plant_Mindwort</defName>
		<label>mindwort</label>
		<graphicData>
			<texPath>Plants/FullGrown/MindwortPlant</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<description>A small, delicate herb with pale green leaves and tiny, yellow flowers, often used in crafting strong elixirs due to its potent properties.</description>
		<plant>
			<growDays>7</growDays>
			<sowWork>800</sowWork>
			<sowMinSkill>4</sowMinSkill>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
			<harvestedThingDef>ISA_Mindwort</harvestedThingDef>
			<purpose>Health</purpose>
			<fertilitySensitivity>0</fertilitySensitivity>
			<sowResearchPrerequisites Inherit="False">
				<li>ISA_AlchemycalAgriculture</li>
			</sowResearchPrerequisites>
		</plant>
	</ThingDef>

	<ThingDef ParentName="HealrootBase" Name="ISA_PoppyBase">
		<defName>ISA_Plant_Poppy</defName>
		<label>poppy</label>
		<graphicData>
			<texPath>Plants/FullGrown/PoppyPlant</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<description>A vibrant plant with striking red flowers, known for its use in various medicinal and alchemical preparations, often valued for its potent effects.</description>
		<plant>
			<growDays>7</growDays>
			<sowWork>800</sowWork>
			<sowMinSkill>4</sowMinSkill>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
			<harvestedThingDef>ISA_Poppy</harvestedThingDef>
			<purpose>Health</purpose>
			<sowResearchPrerequisites Inherit="False">
				<li>ISA_AlchemycalAgriculture</li>
			</sowResearchPrerequisites>
		</plant>
	</ThingDef>

	<!--========== Mushrooms ==========-->

	<ThingDef ParentName="HealrootBase" Name="ISA_HealMushroomBase" Abstract="True">
		<plant>
			<neverBlightable>true</neverBlightable>
      		<growMinGlow>0</growMinGlow>
      		<growOptimalGlow>0</growOptimalGlow>
      		<cavePlant>true</cavePlant>
      		<diesToLight>true</diesToLight>
      		<wildEqualLocalDistribution>false</wildEqualLocalDistribution>
		</plant>
	</ThingDef>
	
	<ThingDef ParentName="ISA_HealMushroomBase" Name="ISA_FlyAgaricBase">
		<defName>ISA_Plant_FlyAgaric</defName>
		<label>fly agaric</label>
		<graphicData>
			<texPath>Plants/FullGrown/FlyAgaricPlant</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<description>A striking mushroom with a bright red cap adorned with white spots, known for its toxic properties. Despite its danger, it has been used in small doses in traditional remedies and rituals, though caution is always advised. It will only grow in dark enviroments but won't die if exposed to light.</description>
		<plant>
			<growDays>7</growDays>
			<sowWork>800</sowWork>
			<sowMinSkill>6</sowMinSkill>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
			<harvestedThingDef>ISA_FlyAgaric</harvestedThingDef>
			<purpose>Health</purpose>
			<diesToLight>false</diesToLight>
			<sowResearchPrerequisites Inherit="False">
				<li>ISA_AlchemycalAgriculture</li>
			</sowResearchPrerequisites>
		</plant>
	</ThingDef>

</Defs>
