	<!-- Pumpkins -->
	
	<ThingDef ParentName="PlantBase">
		<defName>ISA_Plant_Pumpkins</defName>
		<label>pumpkin plant</label>
		<description>A thin green vine which gives way to a characteristically massive orange vegetable, a good visualization of "big things come in small packages". Not particularly tasty on its own, but it makes for a variety of hearty seasonal meals.</description>
		<descriptionHyperlinks>
			<ThingDef>ISA_RawPumpkins</ThingDef>
		</descriptionHyperlinks>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Nutrition>0.5</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Plants/FullGrown/PumpkinPlant</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<selectable>true</selectable>
		<pathCost>10</pathCost>
		<ingestible/>
		<plant>
			<fertilityMin>0.7</fertilityMin>
			<dieIfLeafless>true</dieIfLeafless>
			<harvestTag>Standard</harvestTag>
			<maxMeshCount>1</maxMeshCount>
			<harvestedThingDef>ISA_RawPumpkins</harvestedThingDef>
			<harvestYield>20</harvestYield>
			<!--	<sowResearchPrerequisites>
				<li>DankPyon_AdvancedAgriculture</li>
			</sowResearchPrerequisites>	-->
			<sowTags>
				<li>Ground</li>
			</sowTags>
			<topWindExposure>0.20</topWindExposure>
			<growDays>8</growDays>
			<fertilitySensitivity>0.9</fertilitySensitivity>
			<visualSizeRange>0.8~1.0</visualSizeRange>
			<immatureGraphicPath>Plants/Immature/PumpkinPlant</immatureGraphicPath>
			<wildOrder>2</wildOrder>
			<purpose>Food</purpose>
			<!--<sowMinSkill>8</sowMinSkill>-->
			<harvestFailable>false</harvestFailable>
			<vacuumResistant>true</vacuumResistant>
		</plant>
	</ThingDef>

	<!-- Alraun -->
	
    <ThingDef ParentName="PlantBase">
        <defName>ISA_Plant_Alraun</defName>
        <label>alraun</label>
        <description>Head-sized vegetables with a thin psychic presence. Alrauns were engineered by stoneborn seers as a way to cripple psychic opponents, as when they're disturbed and ripped out of the soil, they emit a psychic pulse that can deafen and daze highly attuned psycasters.</description>
        <statBases>
            <MaxHitPoints>85</MaxHitPoints>
            <Nutrition>0.175</Nutrition>
        </statBases>
        <graphicData>
            <texPath>Plants/FullGrown/MandrakePlant</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <selectable>true</selectable>
        <pathCost>50</pathCost>
        <ingestible />
        <plant>
            <fertilityMin>0</fertilityMin>
            <fertilitySensitivity>0</fertilitySensitivity>
            <harvestTag>Standard</harvestTag>
            <harvestedThingDef>ISA_RawAlraun</harvestedThingDef>
            <harvestYield>15</harvestYield>
            <topWindExposure>0</topWindExposure>
            <growDays>7</growDays>
            <cavePlantWeight>0.1</cavePlantWeight>
            <visualSizeRange>0.8~1.2</visualSizeRange>
            <purpose>Food</purpose>
            <humanFoodPlant>true</humanFoodPlant>
            <maxMeshCount>4</maxMeshCount>
            <growMinGlow>0</growMinGlow>
            <growOptimalGlow>0</growOptimalGlow>
            <diesToLight>false</diesToLight>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
        </plant>
        <comps>
            <li Class="CompProperties_GiveThoughtToAllMapPawnsOnDestroy">
                <thought>ISA_AlraunScream</thought>
                <message>An alraun has been harvested, and it emitted a psychic scream.</message>
            </li>
            <li Class="CompProperties_PlaySoundOnDestroy">
              <!--  <sound>Plant_AlraunScream</sound>	-->
				<sound>AnimaTreeScream</sound>
            </li>
        </comps>
    </ThingDef>

    <ThoughtDef>
        <defName>ISA_AlraunScream</defName>
        <durationDays>2</durationDays>
        <stackLimit>3</stackLimit>
        <effectMultiplyingStat>PsychicSensitivity</effectMultiplyingStat>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <stages>
            <li>
                <label>alraun scream</label>
                <description>What an annoying scream, like chalk on a board...</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

