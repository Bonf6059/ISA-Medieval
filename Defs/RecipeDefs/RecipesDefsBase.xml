<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ======== Recipes ======== -->

  <!-- Alchemy -->
  
  	<RecipeDef Name="ISA_Make_DrugAlchemy" Abstract="True">
		<workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
		<workSkill>Intellectual</workSkill>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_Brewing</soundWorking>
		<allowMixingIngredients>true</allowMixingIngredients>
		<targetCountAdjustment>1</targetCountAdjustment>
		<recipeUsers>
			<li>ISA_AlchemyTable</li>
		</recipeUsers>
		<researchPrerequisites>
			<li>ISA_DrugsMaking</li>
		</researchPrerequisites>		
	</RecipeDef>

  	<RecipeDef ParentName="ISA_Make_DrugAlchemy" Name="ISA_Make_DrugLab" Abstract="True">
		<recipeUsers>
			<li>DrugLab</li>
		</recipeUsers>
	</RecipeDef>

  <!-- Wine must -->
  
	<RecipeDef Name="ISA_Make_MustBase" Abstract="True">
 	<RecipeDef>
		<description>Make must by crushing fruits. Needs to undergo fermentation in order to become wine.</description>
		<jobString>Making must.</jobString>
		<workAmount>1000</workAmount>
		<recipeUsers>
			<li>Brewery</li>
		</recipeUsers>
		<researchPrerequisites>
			<li>Brewing</li>
		</researchPrerequisites>
	</RecipeDef>

  <!-- Mineshaft -->
  
	<RecipeDef Name="ISA_MineShaftBase" Abstract="True">
		<description>Mine deep down underground to obtain rock chunks.</description>
		<workSpeedStat>MiningSpeed</workSpeedStat>
		<workSkill>Mining</workSkill>
		<workSkillLearnFactor>0.50</workSkillLearnFactor>
		<effectWorking>CutStone</effectWorking>
		<soundWorking>Recipe_MakeStoneBlocks</soundWorking>
		<recipeUsers>
			<li>ISA_MineShaft</li>
		</recipeUsers>
	</RecipeDef>

</Defs>
