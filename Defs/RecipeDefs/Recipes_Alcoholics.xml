<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- grape wine must -->
  
 	<RecipeDef ParentName="ISA_Make_MustBase">
		<defName>ISA_MakeMustWine</defName>
		<label>make grape must</label>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_RawGrapes</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ISA_RawGrapes</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<ISA_MustWine>5</ISA_MustWine>
		</products>
	</RecipeDef>

<!-- Berry wine must -->
  
  <RecipeDef ParentName="ISA_Make_MustBase">
		<defName>ISA_MakeMustBerry</defName>
		<label>make berry must</label>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>RawBerries</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>RawBerries</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<ISA_MustWine_Berry>5</ISA_MustWine_Berry>
		</products>
	</RecipeDef>

</Defs>
