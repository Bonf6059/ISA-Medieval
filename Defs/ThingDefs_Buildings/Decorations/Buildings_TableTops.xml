<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Test -->
	
	<ThingDef ParentName="FurnitureBase">
		<defName>ISA_OnTopDecorations</defName>
		<label>random clutter</label>
		<description>Assorted clutter to be used as decoration.</description>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<uiIconScale>0.85</uiIconScale>
		<uiIconOffset>(0, 0.25)</uiIconOffset>
		<building>
			<paintable>false</paintable>
			<isEdifice>false</isEdifice>
		</building>
		<size>(1,1)</size>
		<surfaceType>Item</surfaceType>
		<canOverlapZones>false</canOverlapZones>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<wipesPlants>true</wipesPlants>
		<passability>Standable</passability>
		<pathCost>0</pathCost>
		<clearBuildingArea>false</clearBuildingArea>
		<minifiedDef IsNull="True" />
        <useHitPoints>false</useHitPoints>
		<statBases>
			<WorkToBuild>0</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>3</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">3</StyleDominance>
		</statBases>

		<comps>
			<li Class="CompProperties_Styleable" Inherit="False"/>
			<li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
                <randomGraphics>
                    <li>Building/Furnitures/Decorations/TableTop/Bottles/Bottle_Ale</li>
                    <li>Building/Furnitures/Decorations/TableTop/Bottles/Bottle_Wine</li>
					<li>Building/Furnitures/Decorations/TableTop/Bottles/Bottle_BerryWine</li>

					<li>Building/Furnitures/Decorations/TableTop/ScribeTools/StackPaper</li>
					<li>Building/Furnitures/Decorations/TableTop/ScribeTools/ScrollAndQuill</li>
					<li>Building/Furnitures/Decorations/TableTop/ScribeTools/Book</li>
                </randomGraphics>
                <startAsRandom>false</startAsRandom>
                <disableRandomButton>true</disableRandomButton>
                <optionalNames>
                    <li>Ale mug</li>
                    <li>Wine bottle</li>
					<li>Berry wine bottle</li>

					<li>Stack of paper</li>
					<li>ScrollAndQuill</li>
					<li>Stack of books</li>
                </optionalNames>
            </li>
		</comps>

		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>Furniture</designationCategory>
	</ThingDef>

	
