	<!-- Cash register - Money Box -->
  
  	<ThingDef ParentName="ISA_PlaceableFurnitureOnTopOfTables">
		<defName>ISA_CashRegister</defName>
		<label>cash register</label>
		<description>A small box used as a cash register.</description>
		<category>Building</category>
		<graphicData>
			<texPath>Building/Furnitures/Decorations/CashRegister/CashRegister</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<damageData>
				<rect>(0.35,0.35,0.3,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconScale>0.8</uiIconScale>
		<rotatable>true</rotatable>
		<fillPercent>0.2</fillPercent>
		<costStuffCount>35</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
			<li>Metallic</li>
			<li>Stony</li>
		</stuffCategories>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<WorkToBuild>500</WorkToBuild>
			<Mass>1</Mass>
			<Flammability>0.2</Flammability>
			<Beauty>5</Beauty>
		</statBases>
		<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
		<defaultPlacingRot>South</defaultPlacingRot>
		<minifiedDef>MinifiedThing</minifiedDef>		
	</ThingDef>
	
