<?xml version="1.0" encoding="UTF-8"?>
<Defs>

<!-- Usa <minifiedDef>MinifiedThing</minifiedDef> per rendere le cose minifiable -->

	<!-- ===== Presser ===== -->
	<ThingDef ParentName="BuildingBase">
		<defName>ISA_Presser</defName>
		<label>cheese press</label>
		<description>A wooden contraption to press selected items. Either to bring the juice out or whey from curds.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<drawSize>(2,2)</drawSize>
			<texPath>Building/Production/CheesePress/CheesePress</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<shadowData>
				<volume>(0.75, 0.35, 0.33)</volume>
			</shadowData>
		</graphicData>
		<neverMultiSelect>true</neverMultiSelect>
		<fillPercent>0.45</fillPercent>
		<pathCost>60</pathCost>
		<statBases>
			<WorkToBuild>600</WorkToBuild>
			<Mass>10</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
		</statBases>
		<costList>
			<Steel>10</Steel>
		</costList>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>30</costStuffCount>
		<hasInteractionCell>False</hasInteractionCell>
		<!-- <interactionCellOffset>(0,0,-1)</interactionCellOffset> -->
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<building>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
		</building>
		<size>(2,1)</size>
		<thingClass>Building_WorkTable</thingClass>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="ProcessorFramework.CompProperties_Processor">
				<capacity>100</capacity>
				<independentProcesses>false</independentProcesses>
				<parallelProcesses>false</parallelProcesses>
				<dropIngredients>true</dropIngredients>
				<showProductIcon>true</showProductIcon>
				<barOffset>(0.0, 0.25)</barOffset>
				<barScale>(1.0, 1.0)</barScale>
				<colorCoded>false</colorCoded>
				<processes>
					<li>ISA_MilkIntoCheese</li>
					<li>ISA_SheepMilkIntoCheese</li>
					<li>ISA_GoatMilkIntoCheese</li>
					<li>ISA_RoxMilkIntoCheese</li>
					<li>ISA_MufftonMilkIntoCheese</li>
					<li>ISA_GoldiloxMilkIntoCheese</li>
				</processes>
			</li>
		</comps>
		<tickerType>Rare</tickerType>
		<designationCategory>Production</designationCategory>
		<researchPrerequisites>
			<li>ISA_PresserResearch</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
    	  <li>BuildingsProduction</li>
    	</thingCategories>
	</ThingDef>

	<!-- CrabBay -->

	<ThingDef ParentName="BuildingBase">
		<defName>CrabBay</defName>
		<label>crab bay</label>
		<description>A small, closed-off area of water used to breed a domesticad variant of leviatan crabs, they are smaller in size and are bred specifically to be eaten. The netting prevents any predators from snatching the crabs.\n\nMust be regularly replenished with kibble.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<drawSize>(5,5)</drawSize>
			<texPath>Building/Production/CrabBay/CrabBay</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<thingCategories>
			<li>BuildingsSpecial</li>
		</thingCategories>
		<costList>
			<WoodLog>400</WoodLog>
			<DA_EmperorPearls>1</DA_EmperorPearls>
		</costList>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<costStuffCount>100</costStuffCount>
		<building>
			<destroySound>BuildingDestroyed_Wood_Big</destroySound>
		</building>
		<researchPrerequisites>
			<li>Fishing</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Breakdownable" />
			<li Class="CompProperties_Forbiddable"/>
			<li Class="ProcessorFramework.CompProperties_Processor">
				<capacity>100</capacity>
				<independentProcesses>false</independentProcesses>
				<parallelProcesses>false</parallelProcesses>
				<dropIngredients>false</dropIngredients>
				<showProductIcon>false</showProductIcon>
				<barOffset>(0.0, 0.25)</barOffset>
				<barScale>(1.0, 1.0)</barScale>
				<colorCoded>false</colorCoded>
				<processes>
					<li>ISA_CrabMeat</li>
					<li>ISA_CrabChitin</li>
					<li>ISA_CrabPearl</li>
				</processes>
			</li>	
		</comps>
		<altitudeLayer>Building</altitudeLayer>
		<statBases>
			<MarketValue>1500</MarketValue>
			<MaxHitPoints>200</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Beauty>-10</Beauty>
			<Mass>35</Mass>
			<WorkToBuild>8000</WorkToBuild>
		</statBases>
		<tickerType>Rare</tickerType>
		<size>(3, 3)</size>
		<fillPercent>1.0</fillPercent>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<terrainAffordanceNeeded>Bridgeable</terrainAffordanceNeeded>
		<passability>Impassable</passability>
		<rotatable>true</rotatable>
		<canOverlapZones>true</canOverlapZones>
		<minifiedDef>MinifiedThing</minifiedDef>
		<tradeability>Sellable</tradeability>
		<designationCategory>Production</designationCategory>
	</ThingDef>

<!-- ===== Brew Kettle ===== -->
	
	<ThingDef ParentName="BuildingBase">
    	<defName>ISA_BrewKettle</defName>
    	<label>distillery</label>
    	<description>A rustic distillery used to distill anything that comes to mind, this one looks like it has been modified to make alchemycal concoction.</description>
    	<drawerType>MapMeshAndRealTime</drawerType>
    	<graphicData>
    	  <texPath>Building/Production/BrewKettle/BrewKettle</texPath>
		  <drawSize>4.1</drawSize>
    	  <graphicClass>Graphic_Multi</graphicClass>
    	  <damageData>
    	    <rect>(0.05,0.1,0.9,0.9)</rect>
    	  </damageData>
    	  <shadowData>
    	    <volume>(0.75, 0.35, 0.33)</volume>
    	  </shadowData>
    	</graphicData>
		<size>(2,2)</size>
    	<minifiedDef>MinifiedThing</minifiedDef>
    	<altitudeLayer>Building</altitudeLayer>
    	<passability>PassThroughOnly</passability>
    	<fillPercent>0.45</fillPercent>
    	<pathCost>42</pathCost>
    	<statBases>
    	  <WorkToBuild>1200</WorkToBuild>
    	  <Mass>14</Mass>
    	  <MaxHitPoints>180</MaxHitPoints>
    	  <Flammability>0</Flammability>
    	</statBases>
		<stuffCategories>
    	  <li>Metallic</li>
    	</stuffCategories>
		<comps>
  			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Refuelable">
   				<fuelConsumptionRate>80.0</fuelConsumptionRate>
    			<fuelCapacity>60.0</fuelCapacity>
    			<fuelFilter>
				    <thingDefs>
        				<li>WoodLog</li>
						<li>ISA_Coal</li>
      				</thingDefs>
    			</fuelFilter>
			    <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
  				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
  			</li>
  			<li Class="ProcessorFramework.CompProperties_Processor">
    			<capacity>10</capacity>
    			<independentProcesses>false</independentProcesses>
    			<parallelProcesses>false</parallelProcesses>
    			<dropIngredients>false</dropIngredients>
    			<showProductIcon>false</showProductIcon>
    			<barOffset>(0.0, -0.7)</barOffset>
    			<barScale>(1.2, 1.2)</barScale>
    			<colorCoded>true</colorCoded>
    			<processes>
      				<li>ISA_MushInParegoric</li>
					<li>ISA_MushInRathix</li>
					<li>ISA_MushInDravik</li>
    			</processes>
  			</li>
 		</comps>
 		<tickerType>Rare</tickerType>
  		<rotatable>false</rotatable>
		<designationCategory>Production</designationCategory>
    	<uiOrder>2790</uiOrder>
    	<building>
      		<buildingTags>
        		<li>Production</li>
      		</buildingTags>
      		<destroySound>BuildingDestroyed_Metal_Small</destroySound>
    	</building>
		<costStuffCount>75</costStuffCount>
    	<researchPrerequisites>
	   		<li>ISA_AdvancedDrugsMaking</li>
    	</researchPrerequisites>
    	<thingCategories>
      		<li>BuildingsProduction</li>
    	</thingCategories>
  	</ThingDef>

</Defs>
