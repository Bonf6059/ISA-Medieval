<!-- Armchairs -->
	
	<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>Tav_SoftArmchair</defName>
		<label>soft armchair</label>
		<description>A large, soft upholstered seat. Great for relaxation. Can be used at tables, work stations, and elsewhere.</description>
		<graphicData>
		<texPath>Building/Furnitures/Armchair/SoftArmchair</texPath>
		<graphicClass>Graphic_Multi</graphicClass>
		<drawSize>(3,3)</drawSize>
		<damageData>
			<rectN>(0,0,1,0.703125)</rectN>
			<rectS>(0.09375,0,0.84375,1)</rectS>
			<rectE>(0,0,0.84375,0.625)</rectE>
			<rectW>(0.15625,0,0.84375,0.625)</rectW>
		</damageData>
		<shadowData>
			<volume>(0.3, 0.33, 0.3)</volume>
		</shadowData>
		</graphicData>
		<uiIconScale>0.9</uiIconScale>
		<altitudeLayer>Building</altitudeLayer>
		<statBases>
		<MaxHitPoints>160</MaxHitPoints>
		<WorkToBuild>10000</WorkToBuild>
		<Mass>15</Mass>
		<Flammability>1.0</Flammability>
		<Beauty>8</Beauty>
		<Comfort>1</Comfort>
		</statBases>
		<socialPropernessMatters>true</socialPropernessMatters>
			<costList>
				<Cloth>50</Cloth>
				<WoodLog>75</WoodLog>
			</costList>
		<researchPrerequisites>
		<li>ComplexFurniture</li>
		</researchPrerequisites>
		<pathCost>30</pathCost>
		<fillPercent>0.40</fillPercent>
		<defaultPlacingRot>South</defaultPlacingRot>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<uiOrder>2420</uiOrder>
		<building>
		<isSittable>true</isSittable>
		<destroySound>BuildingDestroyed_Soft_Small</destroySound>
		</building>
		<designationCategory Inherit="False">TavernFurniture</designationCategory>
		<comps>
				<li Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
					<randomGraphics>
						<li>Building/Furnitures/Armchair/SoftArmchair</li>
						<li>Building/Furnitures/Armchair/SoftArmchairA</li>
						<li>Building/Furnitures/Armchair/SoftArmchairB</li>
						<li>Building/Furnitures/Armchair/SoftArmchairC</li>
						<li>Building/Furnitures/Armchair/SoftArmchairD</li>
					</randomGraphics>
					<startAsRandom>false</startAsRandom> 
				</li>
		</comps>
	</ThingDef>

