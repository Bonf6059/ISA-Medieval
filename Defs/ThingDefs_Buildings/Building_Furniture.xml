						<li>Building/Furnitures/Decorations/Trophy/TrophyB</li>
						<li>Building/Furnitures/Decorations/Trophy/TrophyC</li>
						<li>Building/Furnitures/Decorations/Trophy/TrophyD</li>
					</randomGraphics>
					<startAsRandom>false</startAsRandom> 
				</li>
			</comps>
	</ThingDef>
	
