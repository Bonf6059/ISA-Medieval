<!-- Herbs -->
  
  <ThingDef ParentName="PlantFoodRawBase">
		<defName>ISA_RawHerb</defName>
		<label>raw sleetherb</label>
		<description>A bundle of raw sleetherb. They are commonly used in the kitchen for their unique flavour and the cooling sensation that it leaves in your mouth when eaten.</description>
		<graphicData>
			<texPath>Items/Food/RawFood/RawHerb</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>1.3</MarketValue>
		</statBases>
		<ingestible>
            <foodType>VegetableOrFruit</foodType>
            <specialThoughtAsIngredient>ISA_AteHerbsIngredient</specialThoughtAsIngredient>
		</ingestible>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>60</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>

    <ThoughtDef>
        <defName>ISA_AteHerbsIngredient</defName>
        <durationDays>1</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <stages>
            <li>
                <label>chilly!</label>
                <description>I ate a meal with , chilly but delicious!</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

<!-- Sagewick -->
	
