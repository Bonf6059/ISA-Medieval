<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="RoughPlantBase">
		<defName>ISA_RafflesiaLeaves</defName>
		<label>rafflesia petals</label>
		<description>Giant petals of the rafflesia flower. Smell like rotting flesh and are very likely to cause food poisoning when consumed raw. Rafflesia petals can be used for different alchemical recipes.</description>
		<graphicData>
			<texPath>Items/Resources/Plants/Rafflesia/RafflesiaLeaves</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<MarketValue>0.35</MarketValue>
			<Flammability>1</Flammability>
			<Nutrition>0.01</Nutrition>
			<FoodPoisonChanceFixedHuman>0.16</FoodPoisonChanceFixedHuman>
		</statBases>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>30</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<socialPropernessMatters>true</socialPropernessMatters>
		<ingestible>
			<preferability>RawBad</preferability>
			<canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
		</ingestible>
	</ThingDef>

