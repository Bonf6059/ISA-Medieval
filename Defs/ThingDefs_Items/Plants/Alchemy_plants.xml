  <ThingDef ParentName="PlantFoodRawBase">
		<defName>ISA_RawGlowstool</defName>
		<label>raw glowstool</label>
		<description>Raw glowstool fungus obtained by harvesting glowstools growing in caves. Raw glowstool can be used for different alchemical recipes.</description>
		<graphicData>
			<texPath>Items/Resources/Plants/Glowstool/RawGlowstool</texPath>
		</graphicData>
		<statBases>
			<MarketValue>1.1</MarketValue>
			<Mass>0.03</Mass>
		</statBases>
		<ingestible>
			<foodType>Fungus</foodType>
		</ingestible>
		<ingredient>
			<mergeCompatibilityTags>
				<li MayRequire="Ludeon.RimWorld.Ideology">Fungus</li>
			</mergeCompatibilityTags>
		</ingredient>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>40</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
