<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="RoughPlantBase">
		<defName>ISA_AstragalusFlowers</defName>
		<label>astragalus flowers</label>
		<description>Small perennial wildflowers that grow in alpine climates. Astragalus flowers can be used for different alchemical recipes.</description>
		<graphicData>
			<texPath>Items/Resources/Plants/Astragalus/AstragalusFlowers</texPath>
		</graphicData>
		<statBases>
			<MarketValue>0.2</MarketValue>
			<Flammability>1</Flammability>
			<Mass>0.01</Mass>
			<MaxHitPoints>100</MaxHitPoints>
		</statBases>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>30</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<ingestible>
			<preferability>DesperateOnly</preferability>
			<canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
		</ingestible>
	</ThingDef>
	
  <ThingDef ParentName="RoughPlantBase">
		<defName>ISA_CliviaPetals</defName>
		<label>clivia petals</label>
		<description>Petals of an unusual plant with tall, pretty flowers, called ‘bush lily’ by some. Clivia petals can be used for different alchemical recipes.</description>
		<graphicData>
			<texPath>Items/Resources/Plants/Clivia/CliviaPetals</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<MarketValue>0.25</MarketValue>
			<Mass>0.02</Mass>
			<Flammability>1</Flammability>
			<Nutrition>0.01</Nutrition>
			<FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
		</statBases>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>30</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<socialPropernessMatters>true</socialPropernessMatters>
		<ingestible>
			<preferability>RawBad</preferability>
			<canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
		</ingestible>
	</ThingDef>

</Defs>
