<!-- Herbs -->
  
  <ThingDef ParentName="PlantFoodRawBase">
		<defName>ISA_RawHerb</defName>
		<label>raw herbs</label>
		<description>A bundle of raw herbs. It's difficult to pinpoint what kind of herb they are. While commonly used in the kitchen for their unique flavour, they can be used in a variety of alchemical recipes due to their ability to absorb some types of toxins if paired with the right ingredients.</description>
		<graphicData>
			<texPath>Items/Food/RawFood/RawHerb</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>1.3</MarketValue>
		</statBases>
		<ingestible>
            <foodType>VegetableOrFruit</foodType>
            <specialThoughtAsIngredient>ISA_AteHerbsIngredient</specialThoughtAsIngredient>
		</ingestible>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>60</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>

    <ThoughtDef>
        <defName>ISA_AteHerbsIngredient</defName>
        <durationDays>1</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <stages>
            <li>
                <label>spicy!</label>
                <description>I ate a meal with some kind of spice, delicious!</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>
	
</Defs>
