<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!--  Rathix Mush -->
  
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="ISA_Make_RathixMush"]/ingredients/li[3]/filter/thingDefs</xpath>
		<value>
			<thingDefs>
			  <li>ISA_RawAlraun</li>
			</thingDefs>
		</value>
	</Operation>

  <Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="ISA_Make_RathixMush"]/fixedIngredientFilter/thingDefs</xpath>
		<value>
			<thingDefs>
				<li>ISA_FlyAgaric</li>
				<li>DA_Sangonite</li>
				<li>ISA_RawAlraun</li>
			</thingDefs>
		</value>
	</Operation>

