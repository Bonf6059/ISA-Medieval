<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- =============== Alchemy Bench =============== -->
	
<!-- Sagewick balm -->
	
	<RecipeDef ParentName="ISA_Make_DrugAlchemy">
		<defName>ISA_Make_SagewickBalm</defName>
		<label>make sagewick balm</label>
		<description>Make sagewick balm.</description>
		<jobString>Making sagewick balm.</jobString>
		<workAmount>600</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_RawSagewick</li>
					</thingDefs>
				</filter>
				<count>15</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MedicineHerbal</li>
						<li>ISA_Mindwort</li>
						<li>ISA_FlyAgaric</li>
						<li>ISA_Poppy</li>
					</thingDefs>
				</filter>
				<count>6</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ISA_RawSagewick</li>
				<li>MedicineHerbal</li>
				<li>ISA_Mindwort</li>
				<li>ISA_FlyAgaric</li>
				<li>ISA_Poppy</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>ISA_RawSagewick</li>
				<li>MedicineHerbal</li>
				<li>ISA_Mindwort</li>
				<li>ISA_FlyAgaric</li>
				<li>ISA_Poppy</li>
			</thingDefs>
		</defaultIngredientFilter>
		<products>
			<ISA_SagewickBalm>3</ISA_SagewickBalm>
		</products>
	</RecipeDef>
	
<!-- =============== Brew Kettle =============== -->

	<!-- Preil Mush recipe -->

		<RecipeDef ParentName="ISA_Make_DrugAlchemy">
		<defName>ISA_Make_PreilMush</defName>
		<label>make preil mush</label>
		<description>Make preil mush mush.</description>
		<jobString>Making preil mush mush.</jobString>
		<workAmount>375</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_Mindwort</li>
					</thingDefs>
				</filter>
				<count>3</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_RawAlraun</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_RawSagewick</li>
					</thingDefs>
				</filter>
				<count>7</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ISA_Mindwort</li>
				<li>ISA_RawAlraun</li>
				<li>ISA_RawSagewick</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>ISA_Mindwort</li>
				<li>ISA_RawAlraun</li>
				<li>ISA_RawSagewick</li>
			</thingDefs>
		</defaultIngredientFilter>
		<products>
			<ISA_PreilMush>5</ISA_PreilMush>
		</products>
	</RecipeDef>

<!-- Preil Mush Process -->
  
	<ProcessorFramework.ProcessDef ParentName="ISA_BrewKettleBase">
		<defName>ISA_MushInPreil</defName>
		<thingDef>ISA_Preil</thingDef>
		<ingredientFilter>
			<thingDefs>
				<li>ISA_PreilMush</li>
			</thingDefs>
		</ingredientFilter>
		<efficiency>3</efficiency>	<!-- (efficiency) = amount of output for each unit of input -->
	</ProcessorFramework.ProcessDef>

</Defs>
