<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Sagewick Balm -->
	
	<ThingDef ParentName="ISA_Balms">
		<defName>ISA_SagewickBalm</defName>
		<label>sagewick balm</label>
		<description>A concentrated mixture of sagewick essence. It leaves a warm sensation on the skin, helping with cold temperatures and pain.</description>
		<possessionCount>3</possessionCount>
		<graphicData>
			<texPath>Items/Resources/Misc/SagewickBalm</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<ingestible>
    		<foodType>Processed</foodType>
			<nurseable>true</nurseable>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.21,0,0.05)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestHoldUsesTable>false</ingestHoldUsesTable>
			<ingestCommandString>Apply {0}</ingestCommandString>
			<ingestReportString>Applying {0}.</ingestReportString>
			<preferability>NeverForNutrition</preferability>
			<drugCategory>Medical</drugCategory>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
				<hediffDef>ISA_High_SagewickBalm</hediffDef>
				<severity>1.0</severity>
				</li>
			</outcomeDoers>
		</ingestible>
	</ThingDef>

<!-- =============== Preil =============== -->
	
	<ThingDef ParentName="ISA_AlchemyMushBase">
		<defName>ISA_PreilMush</defName>
		<label>preil mush</label>
		<graphicData>
			<texPath>Items/Resources/Misc/PreilMush</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
	</ThingDef>
	
	<ThingDef ParentName="MedicineBase">
		<defName>ISA_Preil</defName>
		<label>preil</label>
		<description>A potent concoction made from alraun, it isn't widely used because when consumed it feels like everything is muffled and you are being cut off form... something. It carries a risk of addiction with prolonged use.</description>
		<possessionCount>10</possessionCount>
		<descriptionHyperlinks><HediffDef>ISA_High_Preil</HediffDef></descriptionHyperlinks>
		<graphicData>
			<texPath>Items/Resources/Preil</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<socialPropernessMatters>false</socialPropernessMatters>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>350</MarketValue> <!-- (Mixture Market value / cauldron drop ammount) + 20-->
			<Mass>0.5</Mass>
			<Flammability>0.1</Flammability>
		</statBases>
		<techLevel>Medieval</techLevel>
		<ingestible>
    		<foodType>Fluid</foodType>
			<nurseable>true</nurseable>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.18,0,0)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestHoldUsesTable>false</ingestHoldUsesTable>
			<ingestCommandString>Drink {0}</ingestCommandString>
			<ingestReportString>Drinking {0}.</ingestReportString>
			<preferability>NeverForNutrition</preferability>
			<drugCategory>Medical</drugCategory>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
				<hediffDef>ISA_High_Preil</hediffDef>
				<severity>1.0</severity>
				</li>
			</outcomeDoers>
		</ingestible>
		
		<comps>
		<li Class="CompProperties_Drug">
			<listOrder>1000</listOrder>
			<overdoseSeverityOffset>0.08~0.14</overdoseSeverityOffset>
		</li>
		</comps>
	</ThingDef>
  
  <HediffDef>
    <defName>ISA_High_Preil</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>preil</label>
    <description>A temporary state increased psychic resistance.</description>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.75</severityPerDay>	<!-- 24h / severityPerDay = how many hours it lasts -->
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
      <stages>
        <li>
	        <statOffsets>
            <PsychicSensitivity>-0.75</PsychicSensitivity>
          </statOffsets>
          <capMods>
				    <li>
					    <capacity>Consciousness</capacity>
					    <offset>-0.10</offset>
				    </li>
        	</capMods>
        </li>
      </stages>
  </HediffDef>

	<ThoughtDef>
		<defName>ISA_Thought_Preil</defName>
		<workerClass>ThoughtWorker_Hediff</workerClass>
		<hediff>ISA_High_Preil</hediff>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		<stages>
		<li>
			<label>drank Preil</label>
			<description>My mind feels muffled, as if I was cut off from the world.</description>
			<baseMoodEffect>-2</baseMoodEffect>
		</li>
		</stages>
	</ThoughtDef>
  
</Defs>
