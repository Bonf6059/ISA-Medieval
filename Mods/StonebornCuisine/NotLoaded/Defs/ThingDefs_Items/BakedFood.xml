		<label>berry pie</label>
		<description>A delicious fruit-tart pie, consisting of a flakey sugar crust layer with a filling of pureed Berry.</description>
		<graphicData>
			<texPath>Items/Food/Baked/Cakes/BerryPie</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
