<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  	<!--Drying rack-->
  
	<ThingDef ParentName="BuildingBase">
		<defName>ISA_DryingRack_Small</defName>
		<label>drying rack (1x2)</label>
		<description>A wooden rack to dry goods under the sun to dehydrate and preserve them for a longer shelf life.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Building/Production/DryingRack/DryingRackSmall/DryingRackSmall</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3,3)</drawSize>
			<damageData>
				<rect>(0.05,0.1,0.9,0.9)</rect>
			</damageData>
		</graphicData>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<altitudeLayer>Building</altitudeLayer>
		<canBeUsedUnderRoof>false</canBeUsedUnderRoof>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.5</fillPercent>
		<pathCost>70</pathCost>
		<statBases>
			<WorkToBuild>500</WorkToBuild>
			<Mass>5</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
		</statBases>
		<size>(2,1)</size>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>50</costStuffCount>
		<thingClass>Building_WorkTable</thingClass>
		<comps>
			<li Class="ProcessorFramework.CompProperties_Processor">
				<capacity>100</capacity>
				<independentProcesses>false</independentProcesses>
				<parallelProcesses>false</parallelProcesses>
				<dropIngredients>true</dropIngredients>
				<showProductIcon>true</showProductIcon>
				<barOffset>(0.0, 0.25)</barOffset>
				<barScale>(1.0, 1.0)</barScale>
				<colorCoded>false</colorCoded>
				<processes>
					<li>ISA_DriedMeatProcess</li>
					<li>ISA_DriedMeatHumanProcess</li>
					<li>ISA_DriedMeatInsectProcess</li>
					<li>ISA_DriedHerbProcess</li>
					<li MayRequire="Ludeon.RimWorld.Odyssey">ISA_DriedFishProcess</li>
				</processes>
			</li>
			<li Class="CompProperties_Forbiddable"/>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_NotUnderRoof</li>
		</placeWorkers>
		<tickerType>Rare</tickerType>
		<designationCategory>Production</designationCategory>
		<researchPrerequisites>
			<li>Pemmican</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
    	  <li>BuildingsProduction</li>
    	</thingCategories>
	</ThingDef>

	<!-- Drying Rack 2x2-->
	
