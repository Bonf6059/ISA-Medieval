<?xml version="1.0" encoding="utf-8"?>
<Patch>

<!-- Plants -->
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/BiomeDef [defName="TemperateForest" or defName="TemperateSwamp" or defName="Tundra" or defName="ColdBog"]/wildPlants</xpath>
		<value>
			<ISA_Plant_MindwortWild>0.05</ISA_Plant_MindwortWild>
			<ISA_Plant_PoppyWild>0.05</ISA_Plant_PoppyWild>
			<ISA_Plant_FlyAgaricWild>0.05</ISA_Plant_FlyAgaricWild>
        </value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/BiomeDef [defName="BorealForest"]/wildPlants</xpath>
		<value>
			<ISA_Plant_MindwortWild>0.16</ISA_Plant_MindwortWild>
			<ISA_Plant_PoppyWild>0.16</ISA_Plant_PoppyWild>
			<ISA_Plant_FlyAgaricWild>0.16</ISA_Plant_FlyAgaricWild>
        </value>
	</Operation>

<!-- Animals -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/BiomeDef [defName="Tundra" or defName="ColdBog" or defName="BorealForest"]/wildAnimals</xpath>
		<value>
			<ISA_Rox>0.4</ISA_Rox>
        </value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/BiomeDef [defName="IceSheet" or defName="SeaIce" or defName="TemperateForest"]/wildAnimals</xpath>
		<value>
			<ISA_Rox>0.1</ISA_Rox>
        </value>
	</Operation>
	
</Patch>
