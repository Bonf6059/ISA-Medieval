<?xml version="1.0" encoding="utf-8"?>
<Patch>

<!--========== TRADERS ==========-->

<Operation Class="PatchOperationSequence">
 <!-- <success>Always</success>  -->
    <operations>
      <!-- Add new caravan -->      <!-- Thank you Criz#2714 for the help with this patch -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/caravanTraderKinds</xpath>
        <value>
          <li>ISA_Caravan_Mythological</li>
        </value>
      </li>

     <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[@Name="TribeBase"]/caravanTraderKinds</xpath>
        <value>
          <li>ISA_Caravan_Mythological</li>
        </value>
      </li>

    <!-- ISA_MithycalAnimals -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="DA_Barog" or defName="DA_BlackScribe" or defName="DA_Crestel" or defName="DA_DwarvenMuffton" or defName="DA_Snaptoad" or defName="DA_Goldilox" or defName="DA_Karabal" or defName="DA_NorthernDrog" or @Name="DA_OwlcatThingBase" or defName="DA_Pilgrim" or defName="DA_ImperialRedhound" or @Name="DA_BaseTaraal"]/tradeTags</xpath>
        <value>
        <li>ISA_MythicalAnimal</li>
        </value>
      </li>

  <li Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="DA_IroncasketBeetle"]</xpath>
    <value>
      <tradeTags>
        <li>ISA_MythicalAnimal</li>
        <li>AnimalExotic</li>
      </tradeTags>
    </value>
  </li>

  </operations>
</Operation>

</Patch>
