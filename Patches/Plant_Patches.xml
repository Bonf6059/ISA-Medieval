<!-- Astragalus -->
  
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Plant_Astragalus"]/plant</xpath>
		<value>
			<harvestYield>3</harvestYield>
			<harvestedThingDef>ISA_AstragalusFlowers</harvestedThingDef>
			<harvestWork>300</harvestWork>
			<harvestTag>Standard</harvestTag>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
			<sowResearchPrerequisites Inherit="False">
				<li>ISA_AlchemycalAgriculture</li>
			</sowResearchPrerequisites>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Plant_Astragalus"]</xpath>
		<value>
			<selectable>true</selectable>
		</value>
	</Operation>

