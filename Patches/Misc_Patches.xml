<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!-- Add coal as a fuel source to everything except passive cooler -->
  
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[not (defName="PassiveCooler")]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs<!--[li="WoodLog"]/li--></xpath>
		<value>
			<li>ISA_Coal</li>
		</value>
	</Operation>

<!-- Change tech level of druglab to medieval -->
  
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DrugLab"]/techLevel</xpath>
		<value>
			<techLevel>
				<li>Medieval</li>
			<techLevel>
		</value>
	</Operation>	
	
</Patch>
